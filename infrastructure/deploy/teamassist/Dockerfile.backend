# Separate API artifact; the existing combined web/API rollout is unchanged.
FROM node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 AS manifests
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/backend/package.json ./apps/backend/package.json
# All workspace manifests are required by the authoritative frozen lockfile.
# No frontend source or build output is copied into any stage.
COPY apps/frontend/package.json ./apps/frontend/package.json
COPY packages/database/package.json ./packages/database/package.json
COPY packages/shared/package.json ./packages/shared/package.json

FROM manifests AS dependencies
RUN pnpm install --frozen-lockfile --ignore-scripts

FROM dependencies AS build
COPY apps/backend/src ./apps/backend/src
COPY packages/database/src ./packages/database/src
COPY packages/shared/src ./packages/shared/src
COPY tsconfig.json ./tsconfig.json
RUN pnpm --filter @daryadarcy/backend build

FROM manifests AS production-dependencies
RUN CI=true pnpm install --prod --frozen-lockfile --ignore-scripts

FROM node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 AS runtime
ARG SOURCE_REVISION
LABEL org.opencontainers.image.revision=$SOURCE_REVISION
ENV NODE_ENV=production
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends default-mysql-client ca-certificates \
    && rm -r /var/lib/apt/lists/* \
    && mkdir /app/backups && chown node:node /app/backups
COPY --from=production-dependencies /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
RUN chmod 0700 /app/backups
USER node
CMD ["node", "dist/index.mjs"]
