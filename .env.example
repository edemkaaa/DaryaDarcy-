# Copy to .env and fill locally. NEVER commit .env with real secrets.

# Database (local MySQL, utf8mb4 required for emoji)
DATABASE_URL=mysql://user:password@127.0.0.1:3306/daryadarcy?charset=utf8mb4

# Auth
JWT_SECRET=change-me-local-dev-only
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Keep this key in the server secret store; retain it for pending encrypted mail.
AUTH_LINK_ENCRYPTION_KEY=

# Legacy owner labels only: privileges require an explicit role=admin in users.
OWNER_OPEN_ID=
OWNER_NAME=
OWNER_EMAIL=
OWNER_PASSWORD=

# S3 Timeweb (optional for local media upload tests)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# Deploy (do not share)
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_PASSWORD=

# Club payments Prodamus (production only)
PRODAMUS_SECRET=
PRODAMUS_PAYFORM_URL=
PRODAMUS_SUBSCRIPTION_ID=
PRODAMUS_SUBSCRIPTION_SECRET=
CLUB_PRICE=
CLUB_SEMIANNUAL_PRICE=

# SMS auth (optional)
SMS_RU_API_ID=
SMS_RU_FROM=

# Public URLs
PUBLIC_APP_URL=http://localhost:8081
# Backend-hosted password page; production uses public HTTPS origin with /api proxy.
PUBLIC_AUTH_URL=http://localhost:3000
# Only the archived Expo client uses this variable. Next.js configuration:
# copy apps/frontend/.env.example to apps/frontend/.env.local.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Shop delivery email (Yandex SMTP)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
# Production требует TLS: для порта 587 с SMTP_SECURE=false обязателен STARTTLS.
# SMTP_FROM — один обычный email, не имя/список; локальные тесты не отправляют реальные письма.
SMTP_USER=daryadarcyapp@yandex.ru
SMTP_PASS=
SMTP_FROM=daryadarcyapp@yandex.ru

# Direct download links for digital shop products (included in purchase email)
SHOP_DIGITAL_1_DOWNLOAD_URL=
SHOP_DIGITAL_2_DOWNLOAD_URL=

# Expo push (native builds) — run `eas init` then paste project UUID here
EAS_PROJECT_ID=

# Admin 2FA — shared TOTP for owner/admin/moderator email & SMS login.
# Generate: node tooling/scripts/generate-admin-totp.mjs
# Leave empty to disable 2FA in dev. Set on production .env + pm2 restart.
ADMIN_TOTP_SECRET=
# First web release: leave optional features off. Enabling requires a separate
# security/consent acceptance; shop online payment has no opt-in yet.
ENABLE_SMS_LOGIN=false
ENABLE_PEN_PALS=false
# Comma-separated exact frontend origins (HTTPS in production). Empty is safest.
CORS_ALLOWED_ORIGINS=
