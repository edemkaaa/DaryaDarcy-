{
  "name": "daryadarcy-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"pnpm dev:server\" \"pnpm dev:frontend\"",
    "dev:server": "pnpm --filter @daryadarcy/backend dev",
    "dev:metro": "pnpm dev:frontend",
    "build": "pnpm --filter @daryadarcy/backend build",
    "build:prodamus-sandbox": "pnpm --filter @daryadarcy/backend build:sandbox",
    "build:prodamus-test": "pnpm --filter @daryadarcy/backend build:prodamus-test",
    "dev:web": "pnpm dev:frontend",
    "build:web": "pnpm --filter @daryadarcy/frontend build",
    "build:web:vite": "node tooling/scripts/copy-web-public.mjs && pnpm --filter @daryadarcy/legacy-web build && node tooling/scripts/compress-web-dist.mjs",
    "start": "pnpm --filter @daryadarcy/backend start",
    "check": "tsc --noEmit && pnpm --filter @daryadarcy/frontend typecheck",
    "check:boundaries": "tsx tooling/scripts/verify-boundaries.ts",
    "check:docs": "tsx tooling/scripts/check-docs.ts",
    "test:db:wait": "tsx tooling/scripts/wait-test-database.ts",
    "lint": "pnpm --filter @daryadarcy/frontend lint",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:video": "node --test --test-reporter=spec apps/video-service/test/*.test.mjs",
    "test:regression": "pnpm verify",
    "test:quiz": "vitest run __tests__/quiz-data.test.ts",
    "verify": "vitest run __tests__/photo-urls.test.ts tests/client-access-api.test.ts tests/client-session-storage.test.ts tests/client-role-policy.test.ts tests/frontend-navigation.test.ts tests/frontend-dev-proxy.test.ts tests/frontend-query-cache.test.ts tests/frontend-post-draft.test.ts tests/frontend-request-lifecycle.test.ts tests/frontend-session-controller.test.ts tests/frontend-personal-storage.test.ts tests/frontend-post-save.test.ts tests/frontend-post-create-intent.test.ts tests/frontend-post-save-atomic.test.ts",
    "extract:woolen": "node tooling/assets/extract-woolen-font.mjs",
    "smoke": "node tooling/operations/smoke-production.mjs",
    "optimize:s3": "node tooling/operations/optimize-s3-assets.mjs",
    "optimize:assets": "node tooling/assets/optimize-local-assets.mjs && node tooling/assets/fix-asset-webp-refs.mjs",
    "deploy:web": "node tooling/operations/deploy-web.mjs",
    "deploy:api": "node tooling/operations/deploy-api.mjs",
    "db:push": "pnpm db:preflight --require-database && drizzle-kit migrate",
    "db:preflight": "tsx tooling/scripts/migration-preflight.ts",
    "qr": "node tooling/scripts/generate_qr.mjs",
    "dev:frontend": "pnpm --filter @daryadarcy/frontend dev",
    "build:frontend": "pnpm --filter @daryadarcy/frontend build",
    "start:frontend": "pnpm --filter @daryadarcy/frontend start",
    "test:frontend": "pnpm --filter @daryadarcy/frontend test:e2e",
    "api:contract": "node tooling/scripts/extract-api-contract.cjs",
    "check:api": "node tooling/scripts/extract-api-contract.cjs --check",
    "db:dev:prepare": "tsx tooling/scripts/prepare-dev-database.ts",
    "dev:web:vite": "pnpm --filter @daryadarcy/legacy-web dev"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1062.0",
    "@tanstack/react-query": "^5.90.12",
    "@trpc/client": "11.8.0",
    "@trpc/react-query": "11.8.0",
    "@trpc/server": "11.8.0",
    "axios": "1.20.0",
    "clsx": "^2.1.1",
    "cookie": "^1.1.1",
    "dotenv": "^16.6.1",
    "drizzle-orm": "0.45.3",
    "express": "^4.22.1",
    "jose": "6.1.0",
    "mysql2": "3.24.5",
    "nodemailer": "10.0.13",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "^7.18.2",
    "superjson": "^1.13.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/cookie": "^0.6.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.19.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.1.17",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.8",
    "esbuild": "0.28.2",
    "eslint": "^9.39.2",
    "prettier": "^3.7.4",
    "qrcode": "^1.5.4",
    "sharp": "0.35.5",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^8.2.1",
    "vitest": "4.1.9"
  },
  "packageManager": "pnpm@9.12.0",
  "pnpm": {
    "overrides": {
      "@babel/core@7.28.5": "7.29.6",
      "babel-plugin-react-compiler@1.0.0>@babel/types": "7.28.5",
      "body-parser@1.20.4": "1.20.6",
      "body-parser@1.20.6>qs": "6.16.0",
      "browserslist@4.28.1": "4.28.7",
      "flatted@3.3.3": "3.4.4",
      "minimatch@3.1.2": "3.1.5",
      "picomatch@2.3.1": "2.3.2",
      "path-to-regexp@0.1.12": "0.1.13",
      "proxy-addr@2.0.7": "2.0.8",
      "qs@6.14.0": "6.16.0",
      "sharp@0.35.4": "0.35.5",
      "shell-quote@1.8.3": "1.11.0",
      "source-map-js@1.2.1": "1.2.2",
      "tar@7.5.2": "7.5.22"
    }
  },
  "license": "ISC",
  "type": "commonjs"
}
