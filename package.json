{
  "name": "app-template",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"pnpm dev:server\" \"pnpm dev:metro\"",
    "dev:server": "pnpm --filter @daryadarcy/backend dev",
    "dev:metro": "pnpm --filter @daryadarcy/frontend dev",
    "build": "pnpm --filter @daryadarcy/backend build",
    "dev:web": "pnpm --filter @daryadarcy/legacy-web dev",
    "build:web": "pnpm --filter @daryadarcy/frontend build:web && node tooling/scripts/compress-web-dist.mjs && node tooling/scripts/pack-web-dist.mjs",
    "build:web:vite": "node tooling/scripts/copy-web-public.mjs && pnpm --filter @daryadarcy/legacy-web build && node tooling/scripts/compress-web-dist.mjs",
    "start": "pnpm --filter @daryadarcy/backend start",
    "check": "tsc --noEmit",
    "check:boundaries": "tsx tooling/scripts/verify-boundaries.ts",
    "lint": "pnpm --filter @daryadarcy/frontend lint",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:regression": "vitest run __tests__/regression.test.ts",
    "test:quiz": "vitest run __tests__/quiz-data.test.ts",
    "verify": "vitest run __tests__/regression.test.ts __tests__/quiz-data.test.ts",
    "extract:woolen": "node tooling/scripts/extract-woolen-font.mjs",
    "generate:audit-pdf": "python3 tooling/scripts/generate-audit-report-pdf.py",
    "smoke": "node tooling/scripts/smoke-production.mjs",
    "optimize:s3": "node tooling/scripts/optimize-s3-assets.mjs",
    "optimize:assets": "node tooling/scripts/optimize-local-assets.mjs && node tooling/scripts/fix-asset-webp-refs.mjs",
    "deploy:web": "node tooling/scripts/deploy-web.mjs",
    "deploy:api": "node tooling/scripts/deploy-api.mjs",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "android": "pnpm --filter @daryadarcy/frontend android",
    "ios": "pnpm --filter @daryadarcy/frontend ios",
    "qr": "node tooling/scripts/generate_qr.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1062.0",
    "@expo-google-fonts/eb-garamond": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/bottom-tabs": "^7.8.12",
    "@react-navigation/elements": "^2.9.2",
    "@react-navigation/native": "^7.1.25",
    "@tanstack/react-query": "^5.90.12",
    "@trpc/client": "11.7.2",
    "@trpc/react-query": "11.7.2",
    "@trpc/server": "11.7.2",
    "axios": "^1.13.2",
    "clsx": "^2.1.1",
    "cookie": "^1.1.1",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.44.7",
    "expo": "~54.0.29",
    "expo-audio": "~1.1.0",
    "expo-blur": "^57.0.2",
    "expo-build-properties": "^1.0.10",
    "expo-constants": "~18.0.12",
    "expo-device": "~8.0.10",
    "expo-document-picker": "^57.0.1",
    "expo-file-system": "^57.0.1",
    "expo-font": "~14.0.10",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-keep-awake": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.10",
    "expo-media-library": "^57.0.3",
    "expo-notifications": "~0.32.15",
    "expo-router": "~6.0.19",
    "expo-screen-capture": "~8.0.9",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "^57.0.7",
    "expo-splash-screen": "~31.0.12",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-video": "~3.0.15",
    "expo-web-browser": "~15.0.10",
    "express": "^4.22.1",
    "jose": "6.1.0",
    "mysql2": "^3.16.0",
    "nodemailer": "^6.10.1",
    "nativewind": "^4.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.6",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.2",
    "react-native-webview": "^14.0.1",
    "react-native-worklets": "0.5.1",
    "react-router-dom": "^7.18.2",
    "superjson": "^1.13.3",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/cookie": "^0.6.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.19.3",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.1.17",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.8",
    "esbuild": "0.28.2",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~10.0.0",
    "prettier": "^3.7.4",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^8.2.1",
    "vitest": "4.1.9"
  },
  "packageManager": "pnpm@9.12.0",
  "description": "",
  "directories": {
    "lib": "lib",
    "test": "tests"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs"
}
