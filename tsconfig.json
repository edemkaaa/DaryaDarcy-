{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": [
      "node",
      "vitest/globals"
    ],
    "paths": {
      "@/*": [
        "./apps/frontend/src/*"
      ],
      "@shared/*": [
        "./packages/shared/src/*"
      ]
    }
  },
  "include": [
    "apps/backend/**/*.ts",
    "packages/**/*.ts",
    "tooling/scripts/**/*.ts",
    "tests/**/*.ts",
    "__tests__/**/*.ts",
    "vitest.config.mts",
    "vitest.setup.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "web-dist",
    "apps/legacy-web",
    "apps/legacy-expo"
  ]
}
