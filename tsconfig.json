{
  "extends": "./apps/frontend/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./apps/frontend/*"],
      "@shared/*": ["./packages/shared/src/*"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "__tests__/**/*.ts",
    "vitest.config.mts",
    "vitest.setup.ts"
  ],
  "exclude": ["node_modules", "dist", "web-dist", "apps/legacy-web"]
}
