{
  "name": "@daryadarcy/backend",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src/_core/index.ts",
    "build": "esbuild src/_core/index.ts --platform=node --packages=external --bundle --format=esm --outfile=../../dist/index.mjs",
    "build:sandbox": "esbuild src/billing/prodamus-sandbox.index.ts --platform=node --packages=external --bundle --format=esm --outfile=../../dist/prodamus-sandbox.mjs",
    "build:prodamus-test": "esbuild src/billing/prodamus-test.index.ts --platform=node --packages=external --bundle --format=esm --outfile=../../dist/prodamus-test.mjs",
    "start": "NODE_ENV=production node ../../dist/index.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1062.0",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@trpc/server": "11.7.2",
    "axios": "^1.13.2",
    "cookie": "^1.1.1",
    "dotenv": "^16.6.1",
    "drizzle-orm": "0.45.3",
    "express": "^4.22.1",
    "file-type": "22.1.1",
    "jose": "6.1.0",
    "mysql2": "3.24.5",
    "nodemailer": "10.0.13",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.4",
    "superjson": "^1.13.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/cookie": "^0.6.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.19.3",
    "cross-env": "^7.0.3",
    "esbuild": "0.28.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  }
}
