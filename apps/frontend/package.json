{
  "name": "@daryadarcy/frontend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 8081",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 8081",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint src e2e playwright*.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:catalog": "playwright test --config playwright.catalog.config.ts",
    "test:e2e:guest-checkout": "playwright test --config playwright.guest-checkout.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.90.12",
    "@trpc/client": "11.8.0",
    "@trpc/react-query": "11.8.0",
    "@trpc/server": "11.8.0",
    "next": "16.4.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "superjson": "1.13.3"
  },
  "devDependencies": {
    "@types/node": "22.19.3",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.9",
    "sass": "1.105.1",
    "typescript": "5.9.3",
    "@playwright/test": "1.58.2",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.4.1"
  }
}
