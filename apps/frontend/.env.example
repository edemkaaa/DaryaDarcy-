NEXT_PUBLIC_API_BASE_URL=
API_PROXY_TARGET=http://127.0.0.1:3000
# Build-time flags; enable only one and rebuild. Defaults preserve live Prodamus.
# Prodamus TEST: backend must route checkout to the isolated demo runtime.
NEXT_PUBLIC_PRODAMUS_TEST_ENABLED=false
# Separate YooKassa TEST interface; incompatible with the Prodamus demo runtime.
NEXT_PUBLIC_CLUB_TEST_CHECKOUT=false
# Enable after schema 0030 and NORMAL_CHECKOUT_RECOVERY_ENABLED on the API are confirmed.
# Authenticated NORMAL purchases only; guests and TEST keep their existing paths.
NEXT_PUBLIC_NORMAL_CHECKOUT_RECOVERY_ENABLED=false
# Mixed video catalog: enable after schema 0031 and VK_CATALOG_ENABLED on the API are confirmed.
NEXT_PUBLIC_VK_CATALOG_ENABLED=false
# Enable/rebuild only after the catalog includeThumbnails + VK thumbnail save contract ships.
NEXT_PUBLIC_VIDEO_THUMBNAILS_ENABLED=false
# Recipes/Petersburg only: enable/rebuild after their files have been migrated.
# Patterns already use the upstream protected API independently of this switch.
# Enable after
# PRIVATE_LIBRARY_FILES_ENABLED + PRIVATE_CONTENT_FILES_ENABLED are accepted on the API.
# Private mode never falls back to old public files or Yandex links on failure.
NEXT_PUBLIC_PRIVATE_LIBRARY_FILES_ENABLED=false
# Server-only legacy Club image guard: leave disabled until a separately approved release.
# Mount the operator's version-1 manifest outside the app/public directories.
LEGACY_CLUB_IMAGE_GUARD_ENABLED=false
# LEGACY_CLUB_IMAGE_MANIFEST_PATH=/run/secrets/legacy-club-images.json
# LEGACY_CLUB_IMAGE_MANIFEST_SHA256=<sha256 of the exact manifest bytes>
